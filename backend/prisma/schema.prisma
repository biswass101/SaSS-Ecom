generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STORE_ADMIN
  CUSTOMER
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STORE_ADMIN)
  stores       Store[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Package {
  id            String             @id @default(cuid())
  name          String
  description   String             @db.Text
  price         Float
  billingCycle  String             @default("monthly")
  maxProducts   Int                @default(50)
  maxOrders     Int                @default(200)
  features      Json
  isActive      Boolean            @default(true)
  subscriptions Subscription[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Store {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?     @db.Text
  logoUrl      String?
  status       StoreStatus @default(INACTIVE)
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id])
  subscription Subscription?
  categories   Category[]
  products     Product[]
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ownerId])
}

model Subscription {
  id        String             @id @default(cuid())
  storeId   String             @unique
  packageId String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  store     Store              @relation(fields: [storeId], references: [id])
  package   Package            @relation(fields: [packageId], references: [id])
  payments  Payment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([packageId])
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Float
  accountNo      String
  transactionId  String
  status         PaymentStatus @default(PENDING)
  verifiedAt     DateTime?
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([subscriptionId])
}

model PaymentChannel {
  id            String   @id @default(cuid())
  name          String
  type          String
  accountNumber String
  instructions  String   @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  title     String
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
}

model Product {
  id          String      @id @default(cuid())
  storeId     String
  categoryId  String
  title       String
  description String      @db.Text
  price       Float
  images      Json
  isActive    Boolean     @default(true)
  stock       Int         @default(0)
  store       Store       @relation(fields: [storeId], references: [id])
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([storeId])
  @@index([categoryId])
}

model Order {
  id              String                @id @default(cuid())
  storeId         String
  orderNumber     String                @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String                @db.Text
  subtotal        Float
  total           Float
  status          OrderStatus           @default(PENDING)
  paymentStatus   OrderPaymentStatus    @default(PENDING)
  notes           String?               @db.Text
  store           Store                 @relation(fields: [storeId], references: [id])
  items           OrderItem[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([storeId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  productTitle String
  productPrice Float
  quantity     Int
  total        Float
  order        Order   @relation(fields: [orderId], references: [id])
  product      Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
